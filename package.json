{
	"name": "vue-popup-plus-root",
	"packageManager": "pnpm@10.19.0",
	"private": true,
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "pnpm -F playground dev",
		"dev:docs": "pnpm -F docs dev",
		"build": "pnpm -F vue-popup-plus build && pnpm -F vue-popup-plus-plugin-preset build",
		"build:core": "pnpm -F vue-popup-plus build",
		"build:plugin": "pnpm -F vue-popup-plus-plugin-preset build",
		"build:docs": "pnpm -F docs build",
		"build:md-demo": "pnpm -F vitepress-plugin-markdown-container-demo build",
		"preview:docs": "pnpm -F docs preview",
		"publish:core:alpha": "pnpm -F vue-popup-plus publish --tag alpha",
		"publish:core:beta": "pnpm -F vue-popup-plus publish --tag beta",
		"publish:core:next": "pnpm -F vue-popup-plus publish --tag next",
		"publish:core:latest": "pnpm -F vue-popup-plus publish --tag latest",
		"publish:plugin:alpha": "pnpm -F vue-popup-plus-plugin-preset publish --tag alpha",
		"publish:plugin:beta": "pnpm -F vue-popup-plus-plugin-preset publish --tag beta",
		"publish:plugin:next": "pnpm -F vue-popup-plus-plugin-preset publish --tag next",
		"publish:plugin:latest": "pnpm -F vue-popup-plus-plugin-preset publish --tag latest",
		"publish:md-demo:alpha": "pnpm -F vitepress-plugin-markdown-container-demo publish --tag alpha",
		"publish:md-demo:beta": "pnpm -F vitepress-plugin-markdown-container-demo publish --tag beta",
		"publish:md-demo:next": "pnpm -F vitepress-plugin-markdown-container-demo publish --tag next",
		"publish:md-demo:latest": "pnpm -F vitepress-plugin-markdown-container-demo publish --tag latest",
		"login": "npm login --registry=https://registry.npmjs.org"
	},
	"devDependencies": {
		"@prettier/plugin-pug": "catalog:",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"concurrently": "^10.0.1"
	}
}
