{
	"name": "vue-popup-plus-plugin-preset",
	"version": "1.6.3",
	"keywords": [
		"vue",
		"vue3",
		"popup",
		"plugin"
	],
	"license": "MIT",
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"main": "dist/vue-popup-plus-plugin-preset.umd.js",
		"module": "dist/vue-popup-plus-plugin-preset.js",
		"types": "dist/vue-popup-plus-plugin-preset.d.ts",
		"exports": {
			".": {
				"import": "./dist/vue-popup-plus-plugin-preset.js",
				"require": "./dist/vue-popup-plus-plugin-preset.umd.js",
				"types": "./dist/vue-popup-plus-plugin-preset.d.ts"
			},
			"./locales/*": {
				"import": "./dist/locales/*.js",
				"require": "./dist/locales/*.js",
				"types": "./dist/locales/*.d.ts"
			}
		}
	},
	"type": "module",
	"files": [
		"dist"
	],
	"main": "src/index.ts",
	"module": "src/index.ts",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		},
		"./locales/*": {
			"import": "./src/locale/langs/*.ts",
			"require": "./src/locale/langs/*.ts"
		}
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "pnpm build:plugin && pnpm build:locales",
		"build:plugin": "vite build",
		"build:locales": "vite build --config vite.config.locales.ts",
		"test:unit": "vitest",
		"build-only": "vite build",
		"lint": "eslint . --fix",
		"format": "prettier --write src/"
	},
	"peerDependencies": {
		"vue": "catalog:",
		"vue-popup-plus": "workspace:~"
	},
	"devDependencies": {
		"@tsconfig/node22": "catalog:",
		"@types/jsdom": "catalog:",
		"@types/node": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"@vitest/eslint-plugin": "catalog:",
		"@vue/eslint-config-prettier": "catalog:",
		"@vue/eslint-config-typescript": "catalog:",
		"@vue/language-plugin-pug": "catalog:",
		"@vue/test-utils": "catalog:",
		"@vue/tsconfig": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-vue": "catalog:",
		"jiti": "catalog:",
		"jsdom": "catalog:",
		"npm-run-all2": "catalog:",
		"prettier": "catalog:",
		"pug": "catalog:",
		"sass": "catalog:",
		"typescript": "catalog:",
		"utils": "workspace:*",
		"vite": "catalog:",
		"vite-plugin-css-injected-by-js": "catalog:",
		"vite-plugin-dts": "catalog:",
		"vite-plugin-vue-devtools": "catalog:",
		"vitest": "catalog:",
		"vue-i18n": "^11.4.4",
		"vue-tsc": "catalog:"
	}
}
