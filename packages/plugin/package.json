{
	"name": "vue-popup-plus-plugin-preset",
	"version": "1.7.0-beta.2",
	"keywords": [
		"vue",
		"vue3",
		"popup",
		"plugin"
	],
	"license": "MIT",
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"main": "dist/index.umd.js",
	"module": "es/index.mjs",
	"types": "es/index.d.ts",
	"exports": {
		".": {
			"types": "./es/index.d.ts",
			"import": "./es/index.mjs",
			"require": "./dist/index.umd.js"
		},
		"./locales/*": {
			"types": "./es/locales/*.d.ts",
			"import": "./es/locales/*.mjs",
			"require": "./dist/locales/*.js"
		}
	},
	"files": [
		"dist",
		"es"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "concurrently -n ES,UMD -c green,blue \"pnpm build:es\" \"pnpm build:umd\"",
		"build:es": "pnpm build:es:plugin && pnpm build:es:locales",
		"build:es:plugin": "vite build",
		"build:es:locales": "vite build --config vite.config.locales.ts",
		"build:umd": "vite build --config vite.config.umd.ts",
		"test:unit": "vitest",
		"build-only": "vite build",
		"lint": "eslint . --fix",
		"format": "prettier --write src/"
	},
	"peerDependencies": {
		"vue": "catalog:",
		"vue-popup-plus": "workspace:~"
	},
	"devDependencies": {
		"@tsconfig/node22": "catalog:",
		"@types/jsdom": "catalog:",
		"@types/node": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"@vitest/eslint-plugin": "catalog:",
		"@vue/eslint-config-prettier": "catalog:",
		"@vue/eslint-config-typescript": "catalog:",
		"@vue/language-plugin-pug": "catalog:",
		"@vue/test-utils": "catalog:",
		"@vue/tsconfig": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-vue": "catalog:",
		"jiti": "catalog:",
		"jsdom": "catalog:",
		"npm-run-all2": "catalog:",
		"prettier": "catalog:",
		"pug": "catalog:",
		"sass": "catalog:",
		"typescript": "catalog:",
		"utils": "workspace:*",
		"vite": "catalog:",
		"vite-plugin-css-injected-by-js": "catalog:",
		"vite-plugin-dts": "catalog:",
		"vite-plugin-vue-devtools": "catalog:",
		"vitest": "catalog:",
		"vue-tsc": "catalog:"
	}
}
